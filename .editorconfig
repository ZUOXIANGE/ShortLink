root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{json,jsonc,yml,yaml,props,targets,csproj,slnx,editorconfig,xml}]
indent_size = 2

[*.{razor}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.cs]
# 命名空间与使用
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# this. 前缀：不强加，保持代码简洁
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# var 使用：类型明显时用 var
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# 表达式体成员
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# 现代语法偏好
csharp_prefer_braces = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:suggestion

# using 指令
dotnet_diagnostic.IDE0005.severity = suggestion

# 空值检查
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
csharp_style_throw_expression = true:suggestion

# 可空性
dotnet_diagnostic.CS8618.severity = warning

# 异步
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA2007.severity = none

# 性能与分析器噪音控制
dotnet_diagnostic.CA1014.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0130.severity = none

# xUnit 的 [CollectionDefinition] 类按框架惯例命名为 <Name>Collection，
# 它们不是集合类型，与 CA1711 的立意（避免把类型误认成集合）不冲突。
[tests/**.cs]
dotnet_diagnostic.CA1711.severity = none

[**/Migrations/*.cs]
generated_code = true

[**/Migrations/**.Designer.cs]
generated_code = true

[**/Migrations/**.Snapshot.cs]
generated_code = true

# 契约 / DTO record 的字段只用于序列化，不参与服务端读取；
# ReSharper 的「位置属性未被访问」在这类类型上属于预期噪音。
[src/ShortLink.Contracts/**.cs]
resharper_not_accessed_positional_property_global_highlighting = none
resharper_unused_auto_property_accessor_global_highlighting = none

[src/ShortLink.Mcp/Models/**.cs]
resharper_not_accessed_positional_property_global_highlighting = none

[src/ShortLink.Application/Abstractions/**.cs]
resharper_not_accessed_positional_property_global_highlighting = none

[src/ShortLink.Application/Messaging/**.cs]
resharper_not_accessed_positional_property_global_highlighting = none

[src/ShortLink.Application/Redirection/RedirectService.cs]
resharper_not_accessed_positional_property_global_highlighting = none

# 配置对象由 ConfigurationBinder 通过 setter 反射赋值。
[src/ShortLink.Application/Options/**.cs]
resharper_unused_auto_property_accessor_global_highlighting = none

# 实体主键的私有 setter 由 EF Core 反射赋值。
[src/ShortLink.Domain/**.cs]
resharper_unused_auto_property_accessor_local_highlighting = none

# 持久化实体（如租约表）的私有 setter 同样由 EF Core 反射赋值。
[src/ShortLink.Infrastructure/Persistence/**.cs]
resharper_unused_auto_property_accessor_local_highlighting = none
