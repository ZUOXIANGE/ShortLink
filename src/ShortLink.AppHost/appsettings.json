{
  "ShortLink": {
    // postgresql（默认，与生产推荐形态一致）| mysql | sqlite（零容器，快速验证用）
    "Database": "postgresql",
    // 与 PostgreSqlImageTag 成对维护（容器镜像标签）
    "PostgreSqlImageTag": "17",
    // 仅在 Database=mysql 时生效
    "MySqlImageTag": "8.4",
    "MySqlVersion": "8.4.0",
    // 关掉即退回进程内缓存与本地限流窗口（单实例可用，多实例会静默不失效）
    "UseRedis": true,
    // 打开会额外拉起 Kafka 容器，并把 Messaging:Transport 切成 kafka
    "UseKafka": false,
    // 默认拉起 RabbitMQ 容器，并把 Messaging:Transport 切成 rabbitmq（与 UseKafka 互斥）
    "UseRabbitMq": true,
    // 本地遥测目标：openobserve（默认，容器里看 traces/metrics/logs）| aspire（发进 Aspire 仪表盘）
    "TelemetryTarget": "openobserve",
    // 与 https://github.com/openobserve/openobserve/releases 的稳定 tag 对齐
    "OpenObserveImageTag": "v1.1.2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
