{
  "ShortLink": {
    // mysql（默认，与生产同构，迁移脚本会被真正跑到）| sqlite（零容器，快速验证用）
    "Database": "mysql",
    // 与 MySqlImageTag 成对维护：ServerVersion 决定 EF 的方言分支
    "MySqlImageTag": "8.4",
    "MySqlVersion": "8.4.0",
    // 关掉即退回进程内缓存与本地限流窗口（单实例可用，多实例会静默不失效）
    "UseRedis": true,
    // 打开会额外拉起 Kafka 容器，并把 Messaging:Transport 切成 kafka
    "UseKafka": false,
    // 打开会额外拉起 RabbitMQ 容器，并把 Messaging:Transport 切成 rabbitmq（与 UseKafka 互斥）
    "UseRabbitMq": false,
    // 本地可观测性后端：OpenObserve（发布产物不含它，生产走标准 OTEL_* 变量）
    "UseOpenObserve": true,
    // 与 https://github.com/openobserve/openobserve/releases 的稳定 tag 对齐
    "OpenObserveImageTag": "v1.1.2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
