@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">重置密码</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudText Typo="Typo.body2">
                将重置账号 <strong>@UserName</strong> 的密码，对方需用新密码重新登录。
            </MudText>

            <MudTextField @bind-Value="_password" Label="新密码" Variant="Variant.Outlined"
                          Margin="Margin.Dense" InputType="InputType.Password" Immediate="true"
                          HelperText="至少 8 位" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">
            确认重置
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public long UserId { get; set; }

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private string _password = string.Empty;
    private string? _error;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        if (_password.Length < 8)
        {
            _error = "新密码至少 8 位";
            return;
        }

        _busy = true;
        try
        {
            var response = await Api.ResetPasswordAsync(UserId, new ResetPasswordRequest { NewPassword = _password });
            if (response.Code == BizCodes.Success)
            {
                Snackbar.Add("密码已重置", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            _error = ErrorMessages.From(response.Code, response.Msg);
        }
        finally
        {
            _busy = false;
        }
    }
}
