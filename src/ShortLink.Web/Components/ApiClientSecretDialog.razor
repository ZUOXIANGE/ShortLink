@inject IJSRuntime Js
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">请立即保存凭据 secret</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudAlert Severity="Severity.Warning" Dense="true">
                secret 只显示这一次，关闭后无法再次查看。丢失只能轮换，旧 secret 会立即失效。
            </MudAlert>

            <MudPaper Elevation="0" Class="panel pa-3">
                <MudText Typo="Typo.caption" Class="hint">名称</MudText>
                <MudText Typo="Typo.body2">@Secret.Name</MudText>

                <MudText Typo="Typo.caption" Class="hint mt-3">KeyId</MudText>
                <MudText Typo="Typo.body2" Class="mono">@Secret.KeyId</MudText>

                <MudText Typo="Typo.caption" Class="hint mt-3">Secret</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.body2" Class="mono secret">@Secret.Secret</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                   OnClick="CopySecretAsync" />
                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.caption" Class="hint">
                请求头：X-Api-Key / X-Timestamp / X-Nonce / X-Signature。
                签名与错误码说明见 docs/api/partner-api.md。
            </MudText>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">我已保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public IssuedApiClientSecret Secret { get; set; } = default!;

    private async Task CopySecretAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", Secret.Secret);
            Snackbar.Add("secret 已复制", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("复制失败，请手动选中复制", Severity.Warning);
        }
    }

    private void Close() => MudDialog.Close();
}

<style>
    .panel {
        border: 1px solid #f0e4e6;
        border-radius: 12px;
        background: #fffafb;
    }

    .mono {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .secret {
        word-break: break-all;
        color: #8c0619;
        font-weight: 600;
    }

    .hint {
        font-size: 12px;
        color: #9b8085;
    }
</style>
