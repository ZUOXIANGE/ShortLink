@inject ApiClient Api

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">修改密码</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudTextField @bind-Value="_oldPassword"
                          Label="原密码"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudTextField @bind-Value="_newPassword"
                          Label="新密码"
                          HelperText="至少 8 位，且同时包含字母与数字"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudTextField @bind-Value="_confirmPassword"
                          Label="确认新密码"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_busy">保存</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _busy;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _error = null;

        if (string.IsNullOrEmpty(_oldPassword))
        {
            _error = "请输入原密码";
            return;
        }

        if (_newPassword.Length < 8 || !_newPassword.Any(char.IsAsciiLetter) || !_newPassword.Any(char.IsAsciiDigit))
        {
            _error = "新密码至少 8 位，且需同时包含字母与数字";
            return;
        }

        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _error = "两次输入的新密码不一致";
            return;
        }

        _busy = true;
        try
        {
            var response = await Api.ChangePasswordAsync(_oldPassword, _newPassword);
            if (response.Code == BizCodes.Success)
            {
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            _error = ErrorMessages.From(response.Code, response.Msg);
        }
        finally
        {
            _busy = false;
        }
    }
}
