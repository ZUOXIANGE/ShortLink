@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#D70B2A",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#8C0619",
            SecondaryContrastText = "#FFFFFF",
            AppbarBackground = "#D70B2A",
            AppbarText = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#2B1214",
            Background = "#F7F5F6",
            Surface = "#FFFFFF",
            TextPrimary = "#2B1214",
            TextSecondary = "#6B4A4F",
            Info = "#8C0619",
            Success = "#1B7F5A",
            Warning = "#B26A00",
            Error = "#C4001D",
            LinesDefault = "#EADCDE",
            TableLines = "#F0E4E6",
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "12px",
            AppbarHeight = "64px",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "PingFang SC", "Microsoft YaHei", "sans-serif"],
            },
        },
    };
}

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <MudText Typo="Typo.h6">当前账号没有访问权限。</MudText>
                }
            </NotAuthorized>
            <Authorizing>
                <div class="d-flex justify-center pa-12">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <MudText Typo="Typo.h5" Class="mb-2">页面不存在</MudText>
            <MudText Typo="Typo.body2">请从左侧导航重新进入。</MudText>
        </LayoutView>
    </NotFound>
</Router>

<div id="blazor-error-ui">
    发生了未处理的错误。
    <a href="" class="reload">刷新页面</a>
    <span class="dismiss">×</span>
</div>
