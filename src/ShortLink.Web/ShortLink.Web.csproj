<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <RootNamespace>ShortLink.Web</RootNamespace>
    <AssemblyName>ShortLink.Web</AssemblyName>
    <ServiceWorker>false</ServiceWorker>
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorEnableCompression>true</BlazorEnableCompression>
    <Description>管理后台 SPA：Blazor WebAssembly + MudBlazor，完全通过 HTTP 调用 API，与后端零代码耦合。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShortLink.Contracts\ShortLink.Contracts.csproj" />
  </ItemGroup>

</Project>
