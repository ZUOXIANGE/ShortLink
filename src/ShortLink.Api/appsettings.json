{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "File": {
      "Enabled": true,
      "JsonPath": "logs/shortlink-api-.jsonl",
      "TextPath": "logs/shortlink-api-.log"
    }
  },
  "Database": {
    "Provider": "MySql",
    "ConnectionString": "",
    "MySqlVersion": "8.0.36"
  },
  "Jwt": {
    "Issuer": "ShortLink",
    "Audience": "ShortLink.Admin",
    "SigningKey": "replace-this-with-a-32-bytes-or-longer-random-secret",
    "ExpiresMinutes": 720
  },
  "Cache": {
    "RedisConnectionString": "",
    "LinkTtlSeconds": 60,
    "DomainTtlSeconds": 60
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminPassword": "",
    "AdminDisplayName": "管理员",
    "DefaultDomainHost": "localhost:5080",
    "DefaultDomainScheme": "http"
  },
  "RateLimit": {
    "UseDistributed": null,
    "AuthPermitPerMinute": 10,
    "ConversionPermitPerMinute": 600,
    "AbusePermitPerMinute": 20,
    "LinkPasswordPermitPerMinute": 10
  },
  "Analytics": {
    "TimeZone": "UTC",
    "Retention": {
      "Enabled": false,
      "ClickRetentionDays": 180,
      "BatchSize": 1000,
      "MaxRowsPerRun": 200000,
      "RunAtHourUtc": 3,
      "BatchDelayMilliseconds": 200
    }
  },
  "Messaging": {
    "Transport": "local",
    "Durable": false,
    "ClickBatchSize": 500,
    "ClickBatchTimeoutMilliseconds": 500,
    "RabbitMq": {
      "ConnectionString": "",
      "QueueName": "shortlink"
    },
    "Kafka": {
      "BootstrapServers": "",
      "TopicPrefix": "shortlink.",
      "ConsumerGroup": "shortlink"
    }
  },
  "GeoIp": {
    "DatabasePath": "",
    "CountryHeaders": ["CF-IPCountry", "X-Country"],
    "ProvinceHeaders": ["X-Province"],
    "Locales": ["zh-CN", "en"]
  },
  "Mcp": {
    "Enabled": false,
    "Path": "/mcp",
    "PermitPerMinute": 120
  },  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5081"
    ]
  },
  "ReverseProxy": {
    "TrustForwardedHeaders": false,
    "KnownProxies": []
  },
  "OpenTelemetry": {
    "Endpoint": "",
    "Headers": ""
  },
  "AllowedHosts": "*"
}
