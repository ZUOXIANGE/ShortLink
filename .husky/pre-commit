#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 只处理暂存的 C# 文件（新增 / 修改 / 重命名）
staged_cs="$(git diff --cached --name-only --diff-filter=ACMR -- '*.cs' | tr -d '\r')"
[ -z "$staged_cs" ] && exit 0

# 1. 先校验：已经合规就零改动直接放行
if dotnet husky run --group pre-commit-verify >/dev/null 2>&1; then
  exit 0
fi

# 2. 同一文件还有未暂存改动时不做自动改写，避免把未暂存内容一并提交
if [ -n "$(git diff --name-only -- $staged_cs | tr -d '\r')" ]; then
  cat >&2 <<'EOF'
暂存的 C# 文件里还有未暂存改动，无法安全地自动格式化。
请先 git add 完整文件（或 git stash）后再提交，也可手动格式化后重试。
EOF
  exit 1
fi

# 3. 自动改写暂存文件，并把结果重新加入暂存区
echo "检测到格式问题，正在自动格式化暂存的 C# 文件 ..." >&2
if ! dotnet husky run --group pre-commit-format; then
  echo "自动格式化失败，请手动运行：dotnet format ShortLink.slnx" >&2
  exit 1
fi
git add -- $staged_cs

# 4. 复核改写结果，仍未达标则阻断提交
if ! dotnet husky run --group pre-commit-verify; then
  echo "自动格式化后仍有不符合 .editorconfig 的内容，需要手动处理。" >&2
  exit 1
fi
