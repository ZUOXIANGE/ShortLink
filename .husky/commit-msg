#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

message_file="$1"
first_line="$(head -n 1 "$message_file" | tr -d '\r')"

# 自动生成的消息不参与格式校验
case "$first_line" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+$'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
提交信息格式不正确，应为 "<type>(<scope>): <subject>"，例如：
  feat(analytics): 增加点击归属地地图展示
  fix: 修复短码不存在时的 500

type 取值：feat fix docs style refactor perf test build ci chore revert
scope 可选、小写，破坏性变更在冒号前加 "!"
临时跳过：HUSKY=0 git commit ...
EOF

exit 1
