<Project>
  <!--
    集中包版本管理（CPM）。
    版本均于 2026-11-11 通过 nuget.org flat container API 核对为当前稳定版。
    约束：目标框架 net10.0，EF Core 固定 10.0.15（11.x 仅支持 net11.0）。
  -->
  <ItemGroup Label="EF Core / 数据库">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <!-- AppHost 显式覆盖 Aspire.Hosting.MySql 的 MySqlConnector 2.3.1 传递依赖。 -->
    <PackageVersion Include="MySqlConnector" Version="3.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      MySQL：官方 Pomelo 最新稳定版 9.0.0 只接受 EF Core 9.0.x（依赖区间 [9.0.0, 9.0.999]），
      在 EF Core 10 上无法使用。改用 Microting 维护的 Pomelo 分支：
        - 版本 10.0.14，MIT 许可（优于 Oracle 官方驱动的 GPL-2.0 + FOSS 例外）
        - 依赖 EF Core Relational [10.0.14, 10.0.999] 与 MySqlConnector 2.6.2，与本项目 EF 10.0.15 兼容
        - API 与 Pomelo 完全一致（UseMySql / ServerVersion）
      详见 docs/adr/0004-multi-database-provider.md
    -->
    <PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="ASP.NET Core 宿主">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="应用层">
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <PackageVersion Include="MaxMind.GeoIP2" Version="6.1.0" />
  </ItemGroup>
  <ItemGroup Label="可观测性">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
  </ItemGroup>
  <ItemGroup Label="前端（Blazor WASM + MudBlazor）">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" />
    <PackageVersion Include="MudBlazor" Version="9.12.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.15" />
    <!-- 二维码：纯托管实现，PngByteQRCode 不依赖 System.Drawing，可在 WASM 内运行 -->
    <PackageVersion Include="QRCoder" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup Label="MCP">
    <!--
      MCP C# SDK：2.4.0 为当前稳定版（2026-11-11 通过 nuget.org flat container 核对）。
      选 .AspNetCore 子包是因为本项目的 MCP Server 以 Streamable HTTP 暴露、复用既有 JWT 认证；
      2.x 的 HttpServerTransportOptions.Stateless 默认 true，语义见 docs/adr/0007-mcp-server.md。
    -->
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup Label="消息与最终一致性">
    <!--
      Wolverine 6.x 为当前主线（5.x 仅维护）。版本均于 2026-11-11 通过 nuget.org flat container 核实。
      三个 RDBMS 消息存储包都取同一版本，保证 outbox/inbox 表结构一致。
      依赖区间已核对：WolverineFx.MySql 依赖 MySqlConnector 2.6.1（项目经 Microting 用 2.6.2，更高、兼容）；
      WolverineFx.EntityFrameworkCore 依赖 EF Core 10.0.4（项目固定 10.0.15，更高、兼容）。
      详见 docs/adr/0008-wolverine-messaging.md
    -->
    <PackageVersion Include="WolverineFx" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Sqlite" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.MySql" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.64.0" />
    <PackageVersion Include="WolverineFx.Kafka" Version="6.64.0" />
    <!--
      Wolverine 6 起核心包不再内置运行时编译器（Roslyn）。Dynamic 模式下没有它会在启动时抛异常。
      生产若要更快的冷启动，可改用 codegen 预生成（TypeLoadMode.Static），见 ADR 0008 遗留项。
    -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.0" />
  </ItemGroup>
  <ItemGroup Label="Aspire 编排（只允许 ShortLink.AppHost 引用）">
    <!--
      AppHost SDK 走 <Project Sdk="Aspire.AppHost.Sdk/13.6.5">，编排核心包由 SDK 隐式引入，
      这里只需显式声明资源集成包。三者必须与 SDK 同版本，否则 Aspire.Hosting 会出现版本打架。
      13.6.5 于 2026-11-12 通过 nuget.org flat container API 核对为当前稳定版。
    -->
    <PackageVersion Include="Aspire.Hosting.MySql" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.6.5" />
    <!--
      发布端（publish）：`aspire publish` 用它们把资源图落成 compose / Helm chart。
      只有 Docker 有稳定版；Kubernetes 目前仍是 preview（13.6.5-preview.1.26559.7），
      引入它属于「可预期的预览依赖」，升级时优先跟同一批 preview 版本。
    -->
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.6.5" />
    <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="13.6.5-preview.1.26559.7" />
  </ItemGroup>
  <ItemGroup Label="测试">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.5" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!--
      Testcontainers（2026-11-12 通过 nuget.org flat container 核对为当前稳定版）。
      只用于「可选」的容器化集成测试：默认不跑，靠环境变量 SHORTLINK_TEST_CONTAINERS=1 开启，
      保证 PR 路径仍是秒级的 SQLite 用例。镜像与 AppHost 保持一致（mysql:8.4 / redis:8.6）。
    -->
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />
  </ItemGroup>
</Project>